# Supabase "ventures" project: Project Settings → Database → Connection string →
# Session pooler (port 5432). Only the worker reads this; it is never passed to Claude.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional. Headless auth for `claude -p` on your Max subscription (from `claude setup-token`).
# If unset, the worker relies on your interactive `claude` login on this machine.
# CLAUDE_CODE_OAUTH_TOKEN=

# NEVER set ANTHROPIC_API_KEY for the worker: it would bill the API instead of your subscription.
# The worker strips it from every child process anyway.

# Optional tuning
# WORKER_ID=my-mac:0
# TICK_MS=60000
# CLAUDE_BIN=claude
# LOG_LEVEL=info

# Tests only: a Postgres >= 15 superuser connection used to create throwaway databases.
# TEST_DATABASE_URL=postgresql://ve:ve@127.0.0.1:5432/ve
